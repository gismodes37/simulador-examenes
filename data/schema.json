{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chilean Radio Amateur Exam Questions",
  "description": "Canonical format for pre-processed exam questions",
  "type": "object",
  "required": ["category", "area", "questions"],
  "properties": {
    "category": {
      "type": "string",
      "enum": ["CD", "CA", "CE", "XQ"],
      "description": "License category code: CD=Novicio, CA=General, CE=Superior, XQ=Experimental"
    },
    "area": {
      "type": "string",
      "enum": ["Reglamento", "Tecnica"],
      "description": "Question area: Reglamento or Tecnica"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "text",
          "option_a",
          "option_b",
          "option_c",
          "option_d",
          "correct_answer"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 10,
            "description": "Question text"
          },
          "option_a": {
            "type": "string",
            "minLength": 1,
            "description": "Option A"
          },
          "option_b": {
            "type": "string",
            "minLength": 1,
            "description": "Option B"
          },
          "option_c": {
            "type": "string",
            "minLength": 1,
            "description": "Option C"
          },
          "option_d": {
            "type": "string",
            "minLength": 1,
            "description": "Option D"
          },
          "correct_answer": {
            "type": "string",
            "enum": ["A", "B", "C", "D"],
            "description": "Correct answer letter"
          },
          "explanation": {
            "type": "string",
            "default": "",
            "description": "Explanation for the correct answer (optional)"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
